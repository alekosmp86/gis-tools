{
  "name": "gis-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run modules:routes",
    "dev": "next dev",
    "prebuild": "npm run modules:routes",
    "build": "next build",
    "modules:routes": "node scripts/generate-module-routes.cjs",
    "modules:routes:check": "node scripts/generate-module-routes.cjs --check",
    "start": "next start",
    "lint": "eslint",
    "doctor": "react-doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "graph": "node scripts/generate-dependency-graph.cjs",
    "graph:serve": "node scripts/serve-dependency-graph.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "proj4": "^2.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shpjs": "^3.4.7",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "react-doctor": "^0.9.12",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
